rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true && request.auth.token.email == 'reocleanproperties@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Products
    match /products/{productId} {
      allow read, write: if true;
    }

    // Categories
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Orders
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Admin List
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Users
    match /users/{userId} {
      allow read, write: if true;
    }

    // Manual Invoices
    match /manualInvoices/{invoiceId} {
      allow read, write: if true;
    }

    // Public Activity (for Social Proof)
    match /public_activity/{activityId} {
      allow read, write: if true;
    }

    // Customer Gallery
    match /customerGallery/{galleryId} {
      allow read, write: if true;
    }

    // Sliders
    match /sliders/{sliderId} {
      allow read, write: if true;
    }

    // Producers
    match /producers/{producerId} {
      allow read, write: if true;
    }

    // Press Coverages
    match /press/{pressId} {
      allow read, write: if true;
    }

    // Site Settings
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
